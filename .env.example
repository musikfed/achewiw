# Password-free access is restricted to local/private VPN IP addresses in FastAPI.
# Do NOT expose port 7080 directly to the Internet.
ACHEWIW_MODEL=qwen3:8b
ACHEWIW_ALLOWED_HOSTS=192.168.0.100,127.0.0.1,localhost
# Use the UID/GID of the Linux account owning ./data.
ACHEWIW_UID=1000
ACHEWIW_GID=1000
